{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Zappo",
    "version": "0.1.0",
    "identifier": "dev.marcuth.zappo",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Zappo",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "maximized": true
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
